---
import Base from '../layouts/Base.astro';
import { ABONNEMENTS } from '../lib/inscription';

const aujourdhui = new Date().toISOString().slice(0, 10);
---

<Base titre="Dossier d'inscription" description="Remplissez votre dossier d'inscription à la Kerner Team en ligne et téléchargez-le en PDF, prêt à imprimer.">
  <section class="section">
    <div class="conteneur conteneur--formulaire">
      <p class="surtitre"><a href="/tarifs/#inscription">Tarifs & inscription</a></p>
      <h1 class="titre-page">DOSSIER D'INSCRIPTION</h1>
      <div class="intro">
        <p>
          Remplissez ce formulaire pour obtenir votre dossier complet en PDF : fiche d'adhésion, autorisation parentale
          (pour les mineurs) et règlement intérieur, déjà remplis.
        </p>
        <p class="intro__confidentialite">
          Le PDF est créé directement sur votre appareil. Aucune information n'est envoyée ni enregistrée par le site.
        </p>
      </div>

      <form class="formulaire" id="formulaire-inscription" novalidate>
        <!-- ------------------------------------------------ Adhérent -->
        <fieldset class="bloc">
          <legend class="bloc__titre">L'adhérent</legend>
          <div class="champs">
            <label class="champ">
              <span>Nom <abbr title="obligatoire">*</abbr></span>
              <input name="nom" required autocomplete="family-name" />
            </label>
            <label class="champ">
              <span>Prénom <abbr title="obligatoire">*</abbr></span>
              <input name="prenom" required autocomplete="given-name" />
            </label>
            <label class="champ">
              <span>Date de naissance <abbr title="obligatoire">*</abbr></span>
              <input name="naissance" type="date" required max={aujourdhui} autocomplete="bday" />
            </label>
            <label class="champ">
              <span>Lieu de naissance <span class="champ__aide" data-si-mineur hidden>(obligatoire pour un mineur)</span></span>
              <input name="lieuNaissance" />
            </label>
            <fieldset class="champ champ--radios">
              <legend>Sexe</legend>
              <label><input type="radio" name="sexe" value="H" /> H</label>
              <label><input type="radio" name="sexe" value="F" /> F</label>
            </fieldset>
            <label class="champ">
              <span>Numéro de téléphone <abbr title="obligatoire">*</abbr></span>
              <input name="telephone" type="tel" required autocomplete="tel" />
            </label>
            <label class="champ">
              <span>E-mail <abbr title="obligatoire">*</abbr></span>
              <input name="email" type="email" required autocomplete="email" />
            </label>
            <label class="champ">
              <span>Numéro Pass'Sport <span class="champ__aide">(si éligible)</span></span>
              <input name="passSport" />
            </label>
            <label class="champ champ--large">
              <span>Adresse <abbr title="obligatoire">*</abbr></span>
              <input name="adresse" required autocomplete="street-address" />
            </label>
            <label class="champ">
              <span>Code postal <abbr title="obligatoire">*</abbr></span>
              <input name="codePostal" required inputmode="numeric" pattern="\d{5}" autocomplete="postal-code" />
            </label>
            <label class="champ">
              <span>Ville <abbr title="obligatoire">*</abbr></span>
              <input name="ville" required autocomplete="address-level2" />
            </label>
            <label class="champ champ--large">
              <span>Personne(s) à prévenir en cas d'accident + téléphone <abbr title="obligatoire">*</abbr></span>
              <input name="urgence" required placeholder="Ex. Claire Dupont (mère) – 06 12 34 56 78" />
            </label>
          </div>
        </fieldset>

        <!-- ------------------------------------------------ Abonnement -->
        <fieldset class="bloc">
          <legend class="bloc__titre">Type d'abonnement <abbr title="obligatoire">*</abbr></legend>
          <div class="abonnements">
            {
              ABONNEMENTS.map((a, i) => (
                <label class="abonnement">
                  <input type="radio" name="abonnement" value={a.id} required={i === 0} />
                  <span>{a.libelle}</span>
                </label>
              ))
            }
          </div>
          <p class="champ__aide">Tarifs détaillés sur la page <a href="/tarifs/">Tarifs</a>.</p>
        </fieldset>

        <!-- ------------------------------------------------ Responsable légal -->
        <fieldset class="bloc bloc--mineur" data-bloc-mineur hidden disabled>
          <legend class="bloc__titre">Responsable légal</legend>
          <p class="bloc__explication">L'adhérent a moins de 18 ans : une autorisation parentale est ajoutée au dossier.</p>
          <div class="champs">
            <label class="champ">
              <span>Nom et prénom du responsable <abbr title="obligatoire">*</abbr></span>
              <input name="responsableNom" required autocomplete="name" />
            </label>
            <fieldset class="champ champ--radios">
              <legend>Qualité <abbr title="obligatoire">*</abbr></legend>
              <label><input type="radio" name="responsableQualite" value="pere" required /> Père</label>
              <label><input type="radio" name="responsableQualite" value="mere" /> Mère</label>
              <label><input type="radio" name="responsableQualite" value="tuteur" /> Tuteur</label>
            </fieldset>
            <label class="champ">
              <span>Téléphone du responsable <abbr title="obligatoire">*</abbr></span>
              <input name="responsableTelephone" type="tel" required />
            </label>
            <label class="case champ--large">
              <input type="checkbox" name="memeAdresse" checked data-meme-adresse />
              <span>Le responsable habite à la même adresse que l'adhérent</span>
            </label>
            <div class="champs champ--large" data-adresse-responsable hidden>
              <label class="champ champ--large">
                <span>Adresse du responsable <abbr title="obligatoire">*</abbr></span>
                <input name="responsableAdresse" required disabled />
              </label>
              <label class="champ">
                <span>Code postal <abbr title="obligatoire">*</abbr></span>
                <input name="responsableCodePostal" required disabled inputmode="numeric" pattern="\d{5}" />
              </label>
              <label class="champ">
                <span>Ville <abbr title="obligatoire">*</abbr></span>
                <input name="responsableVille" required disabled />
              </label>
            </div>
          </div>
        </fieldset>

        <!-- ------------------------------------------------ Règlement et signature -->
        <fieldset class="bloc">
          <legend class="bloc__titre">Règlement et signature</legend>
          <div class="champs">
            <label class="case champ--large">
              <input type="checkbox" name="reglement" required />
              <span>
                J'ai lu et j'accepte le <a href="/documents/reglement-interieur.pdf" target="_blank" rel="noopener">règlement intérieur</a>
                <abbr title="obligatoire">*</abbr>
              </span>
            </label>
            <label class="case champ--large">
              <input type="checkbox" name="refusImage" />
              <span>Je refuse la diffusion des photos prises pendant les entraînements et compétitions (article 6 du règlement)</span>
            </label>
            <label class="champ">
              <span>Fait à <abbr title="obligatoire">*</abbr></span>
              <input name="faitA" required value="Paris" />
            </label>
          </div>

          <div class="signature">
            <p class="signature__titre" id="signature-titre">
              Signature <span data-libelle-signataire>de l'adhérent</span>
              <span class="champ__aide">(facultatif : vous pouvez aussi signer à la main après impression)</span>
            </p>
            <canvas class="signature__zone" aria-labelledby="signature-titre" data-signature></canvas>
            <button type="button" class="bouton-texte" data-effacer-signature>Effacer la signature</button>
          </div>

          <div class="photo">
            <label class="champ">
              <span>Photo d'identité <span class="champ__aide">(facultatif, sinon à apporter)</span></span>
              <input type="file" name="photo" accept="image/*" data-photo />
            </label>
            <img class="photo__apercu" alt="Aperçu de la photo" data-apercu-photo hidden />
          </div>
        </fieldset>

        <p class="formulaire__erreur" role="alert" data-erreur hidden></p>

        <button type="submit" class="bouton formulaire__envoi" data-envoi>Générer mon dossier PDF</button>
      </form>

      <section class="resultat" data-resultat hidden tabindex="-1" aria-labelledby="resultat-titre">
        <h2 class="titre-section" id="resultat-titre">Votre dossier est prêt</h2>
        <p><a class="bouton" data-lien-pdf download>Télécharger le PDF</a></p>
        <p>Imprimez-le et apportez-le lors de l'inscription, avec :</p>
        <ul>
          <li>un certificat médical d'aptitude à la pratique ;</li>
          <li data-rappel-photo>une photo d'identité ;</li>
          <li>le règlement de la cotisation (espèces ou chèques).</li>
        </ul>
        <p data-rappel-mineur hidden>Pour un mineur, l'enfant signe aussi le règlement intérieur.</p>
        <p data-rappel-signature hidden>N'oubliez pas de signer le dossier à la main.</p>
        <p><button type="button" class="bouton-texte" data-modifier>Modifier mes informations</button></p>
      </section>
    </div>
  </section>
</Base>

<style>
  .conteneur--formulaire { max-width: calc(860px + 2 * var(--gouttiere)); }
  .surtitre a { color: inherit; text-decoration: none; }
  .surtitre a::before { content: '← '; }
  .intro { color: var(--texte-doux); max-width: 68ch; margin-bottom: 32px; }
  .intro__confidentialite {
    border-left: 4px solid var(--rouge);
    padding: 10px 14px;
    background: var(--panneau);
    color: var(--texte);
  }

  .formulaire { display: grid; gap: 20px; }
  .bloc {
    margin: 0;
    padding: 20px;
    background: var(--panneau);
    border: 1px solid var(--bord);
    border-top: 4px solid var(--rouge);
    border-radius: var(--rayon);
    min-width: 0;
  }
  .bloc__titre {
    float: left;
    width: 100%;
    font-family: var(--titres);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0;
    margin-bottom: 16px;
  }
  .bloc__titre + * { clear: both; }
  .bloc__explication { color: var(--texte-doux); }

  .champs { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 640px) {
    .champs { grid-template-columns: 1fr 1fr; }
    .champ--large { grid-column: 1 / -1; }
  }
  .champ { display: grid; gap: 6px; font-size: 0.95rem; min-width: 0; }
  .champ > span:first-child, .champ > legend { font-weight: 600; }
  .champ__aide { font-weight: 400; color: var(--texte-doux); font-size: 0.88rem; }
  abbr[title] { text-decoration: none; color: var(--rouge-texte); }

  input:not([type='radio'], [type='checkbox'], [type='file']) {
    font: inherit;
    color: var(--texte);
    background: #0f0f0f;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--rayon);
    padding: 10px 12px;
    min-height: 46px;
    width: 100%;
    color-scheme: dark;
  }
  input:focus-visible { outline: 3px solid var(--rouge-texte); outline-offset: 1px; }
  input:user-invalid { border-color: var(--rouge-texte); }
  input[type='radio'], input[type='checkbox'] { accent-color: var(--rouge); width: 20px; height: 20px; margin: 0; flex: none; }
  input[type='file'] { font: inherit; color: var(--texte-doux); }

  .champ--radios { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .champ--radios legend { padding: 0; margin-bottom: 6px; width: 100%; }
  .champ--radios label { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }

  .case { display: flex; align-items: flex-start; gap: 10px; font-size: 0.95rem; }
  .case input { margin-top: 3px; }

  .abonnements { display: grid; gap: 8px; }
  @media (min-width: 640px) { .abonnements { grid-template-columns: 1fr 1fr; } }
  .abonnement {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--bord);
    border-radius: var(--rayon);
    background: var(--panneau-plein);
    cursor: pointer;
    font-size: 0.95rem;
  }
  .abonnement:has(input:checked) { border-color: var(--rouge); background: rgb(196 22 28 / 0.15); }

  .signature { margin-top: 24px; display: grid; gap: 8px; justify-items: start; }
  .signature__titre { font-weight: 600; margin: 0; }
  .signature__zone {
    width: 100%;
    max-width: 520px;
    height: 180px;
    background: #fff;
    border-radius: var(--rayon);
    border: 2px dashed var(--texte-doux);
    touch-action: none;
    cursor: crosshair;
  }
  .bouton-texte {
    font: inherit;
    background: none;
    border: 0;
    padding: 6px 0;
    color: var(--rouge-texte);
    text-decoration: underline;
    cursor: pointer;
  }

  .photo { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .photo__apercu { width: 96px; height: 96px; border-radius: 50%; border: 3px solid var(--rouge); }

  .formulaire__erreur {
    margin: 0;
    padding: 12px 16px;
    border: 1px solid var(--rouge-texte);
    border-radius: var(--rayon);
    background: rgb(196 22 28 / 0.15);
  }
  .formulaire__envoi { justify-self: start; }
  .formulaire__envoi[disabled] { opacity: 0.6; cursor: progress; }

  .resultat {
    margin-top: 32px;
    padding: 24px;
    background: var(--panneau);
    border: 1px solid var(--rouge);
    border-radius: var(--rayon);
  }
  .resultat ul { padding-left: 1.2em; }
</style>

<script>
  import ficheUrl from '../assets/modeles/fiche-adhesion.png?url';
  import autorisationUrl from '../assets/modeles/autorisation-parentale.pdf?url';
  import reglementUrl from '../assets/modeles/reglement-interieur.pdf?url';
  import { age, type Dossier, type Qualite } from '../lib/inscription';

  const form = document.querySelector<HTMLFormElement>('#formulaire-inscription')!;
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const champ = (nom: string) => form.elements.namedItem(nom) as HTMLInputElement;

  const blocMineur = $<HTMLFieldSetElement>('[data-bloc-mineur]');
  const memeAdresse = $<HTMLInputElement>('[data-meme-adresse]');
  const adresseResponsable = $('[data-adresse-responsable]');
  const erreur = $('[data-erreur]');
  const envoi = $<HTMLButtonElement>('[data-envoi]');
  const resultat = $('[data-resultat]');

  // ------------------------------------------------------------ Mineur ?
  const estMineur = () => {
    const naissance = champ('naissance').value;
    return Boolean(naissance) && age(naissance, new Date()) < 18;
  };
  const majMineur = () => {
    const mineur = estMineur();
    blocMineur.hidden = !mineur;
    blocMineur.disabled = !mineur;
    champ('lieuNaissance').required = mineur;
    document.querySelectorAll<HTMLElement>('[data-si-mineur]').forEach((el) => (el.hidden = !mineur));
    $('[data-libelle-signataire]').textContent = mineur ? 'du responsable légal' : "de l'adhérent";
  };
  champ('naissance').addEventListener('change', majMineur);

  const majAdresse = () => {
    const autre = !memeAdresse.checked;
    adresseResponsable.hidden = !autre;
    adresseResponsable.querySelectorAll('input').forEach((i) => (i.disabled = !autre));
  };
  memeAdresse.addEventListener('change', majAdresse);
  majMineur();
  majAdresse();

  // ------------------------------------------------------------ Signature
  const canvas = $<HTMLCanvasElement>('[data-signature]');
  const ctx = canvas.getContext('2d')!;
  let traits = 0;
  let limites = { x1: Infinity, y1: Infinity, x2: -Infinity, y2: -Infinity };
  let enCours = false;

  const preparer = () => {
    const r = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(r.width * dpr);
    canvas.height = Math.round(r.height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.lineWidth = 2.6;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#121a3a';
    traits = 0;
    limites = { x1: Infinity, y1: Infinity, x2: -Infinity, y2: -Infinity };
  };
  const point = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    const p = { x: e.clientX - r.left, y: e.clientY - r.top };
    limites = { x1: Math.min(limites.x1, p.x), y1: Math.min(limites.y1, p.y), x2: Math.max(limites.x2, p.x), y2: Math.max(limites.y2, p.y) };
    return p;
  };
  canvas.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    canvas.setPointerCapture(e.pointerId);
    enCours = true;
    const p = point(e);
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(p.x + 0.1, p.y + 0.1);
    ctx.stroke();
    traits++;
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!enCours) return;
    const p = point(e);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
  });
  const finir = () => (enCours = false);
  canvas.addEventListener('pointerup', finir);
  canvas.addEventListener('pointercancel', finir);
  $('[data-effacer-signature]').addEventListener('click', () => {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    preparer();
  });
  preparer();

  const enPng = (c: HTMLCanvasElement) =>
    new Promise<Uint8Array>((ok, ko) =>
      c.toBlob(async (b) => (b ? ok(new Uint8Array(await b.arrayBuffer())) : ko(new Error('Image vide'))), 'image/png'),
    );

  /** Signature recadrée sur le tracé (sinon le PDF la réduirait inutilement). */
  const exporterSignature = async () => {
    if (!traits) return undefined;
    const dpr = canvas.width / canvas.getBoundingClientRect().width;
    const marge = 6;
    const x = Math.max(0, (limites.x1 - marge) * dpr);
    const y = Math.max(0, (limites.y1 - marge) * dpr);
    const l = Math.min(canvas.width - x, (limites.x2 - limites.x1 + 2 * marge) * dpr);
    const h = Math.min(canvas.height - y, (limites.y2 - limites.y1 + 2 * marge) * dpr);
    const sortie = document.createElement('canvas');
    sortie.width = Math.max(1, Math.round(l));
    sortie.height = Math.max(1, Math.round(h));
    sortie.getContext('2d')!.drawImage(canvas, x, y, l, h, 0, 0, sortie.width, sortie.height);
    return enPng(sortie);
  };

  // ------------------------------------------------------------ Photo (recadrée en cercle)
  let photo: Uint8Array | undefined;
  const apercu = $<HTMLImageElement>('[data-apercu-photo]');
  $<HTMLInputElement>('[data-photo]').addEventListener('change', async (e) => {
    const fichier = (e.target as HTMLInputElement).files?.[0];
    photo = undefined;
    apercu.hidden = true;
    if (!fichier) return;
    try {
      const url = URL.createObjectURL(fichier);
      const img = new Image();
      await new Promise((ok, ko) => ((img.onload = ok), (img.onerror = ko), (img.src = url)));
      const cote = Math.min(img.naturalWidth, img.naturalHeight);
      const taille = 480;
      const c = document.createElement('canvas');
      c.width = c.height = taille;
      const g = c.getContext('2d')!;
      g.beginPath();
      g.arc(taille / 2, taille / 2, taille / 2, 0, Math.PI * 2);
      g.clip();
      g.drawImage(img, (img.naturalWidth - cote) / 2, (img.naturalHeight - cote) / 2, cote, cote, 0, 0, taille, taille);
      URL.revokeObjectURL(url);
      photo = await enPng(c);
      apercu.src = c.toDataURL('image/png');
      apercu.hidden = false;
    } catch {
      erreur.textContent = "Cette photo n'a pas pu être lue. Essayez une image JPEG ou PNG.";
      erreur.hidden = false;
    }
  });

  // ------------------------------------------------------------ Génération
  let urlPdf: string | undefined;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    erreur.hidden = true;
    majMineur();
    if (!form.reportValidity()) return;

    const v = (nom: string) => (champ(nom)?.value ?? '').trim();
    const mineur = estMineur();
    const meme = memeAdresse.checked;
    const donnees = new FormData(form);
    const dossier: Dossier = {
      nom: v('nom'),
      prenom: v('prenom'),
      naissance: v('naissance'),
      lieuNaissance: v('lieuNaissance'),
      sexe: (donnees.get('sexe') as 'H' | 'F' | null) ?? '',
      telephone: v('telephone'),
      email: v('email'),
      passSport: v('passSport'),
      adresse: v('adresse'),
      codePostal: v('codePostal'),
      ville: v('ville'),
      urgence: v('urgence'),
      abonnement: String(donnees.get('abonnement') ?? ''),
      mineur,
      responsable: {
        nom: v('responsableNom'),
        qualite: (donnees.get('responsableQualite') as Qualite | null) ?? 'tuteur',
        adresse: meme ? v('adresse') : v('responsableAdresse'),
        codePostal: meme ? v('codePostal') : v('responsableCodePostal'),
        ville: meme ? v('ville') : v('responsableVille'),
        telephone: v('responsableTelephone'),
      },
      faitA: v('faitA'),
      date: new Date(),
      refusImage: champ('refusImage').checked,
      signature: await exporterSignature(),
      photo,
    };

    envoi.disabled = true;
    envoi.textContent = 'Génération en cours…';
    try {
      const { genererDossier } = await import('../lib/dossier-pdf');
      const octets = await genererDossier(dossier, { fiche: ficheUrl, autorisation: autorisationUrl, reglement: reglementUrl });
      if (urlPdf) URL.revokeObjectURL(urlPdf);
      urlPdf = URL.createObjectURL(new Blob([octets], { type: 'application/pdf' }));

      const nomFichier = `dossier-inscription-kerner-team-${dossier.nom}-${dossier.prenom}`
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/-+$/, '');
      const lien = $<HTMLAnchorElement>('[data-lien-pdf]');
      lien.href = urlPdf;
      lien.download = `${nomFichier}.pdf`;

      $('[data-rappel-photo]').hidden = Boolean(photo);
      $('[data-rappel-mineur]').hidden = !mineur;
      $('[data-rappel-signature]').hidden = Boolean(dossier.signature);
      form.hidden = true;
      resultat.hidden = false;
      resultat.focus();
      resultat.scrollIntoView({ block: 'start' });
      lien.click();
    } catch (err) {
      console.error(err);
      erreur.textContent = "Le PDF n'a pas pu être généré. Réessayez, ou téléchargez les documents vierges sur la page Tarifs & inscription.";
      erreur.hidden = false;
    } finally {
      envoi.disabled = false;
      envoi.textContent = 'Générer mon dossier PDF';
    }
  });

  $('[data-modifier]').addEventListener('click', () => {
    resultat.hidden = true;
    form.hidden = false;
    form.scrollIntoView({ block: 'start' });
  });
</script>
