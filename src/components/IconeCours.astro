---
// Icônes des cours, dessinées au trait (24 × 24), couleur héritée du texte.
interface Props {
  type: 'muay-thai' | 'mma' | 'kids-ados' | 'feminin';
  class?: string;
}
const { type, class: classe } = Astro.props;
---

<svg
  class:list={['icone-cours', classe]}
  viewBox="0 0 24 24"
  width="40"
  height="40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    type === 'muay-thai' && (
      <>
        {/* Gant de boxe */}
        <path d="M8 3.5h6.5A4.5 4.5 0 0 1 19 8v4.2a4.8 4.8 0 0 1-2.6 4.3V18H8.6v-1.6A6 6 0 0 1 5 10.9V6.5a3 3 0 0 1 3-3z" />
        <path d="M5 10.5a2.6 2.6 0 0 0 2.6 2.6h3.2" />
        <path d="M9.5 6.5h5.5" />
        <rect x="8.2" y="18" width="8.6" height="3" rx="0.8" />
      </>
    )
  }
  {
    type === 'mma' && (
      <>
        {/* Octogone (cage) */}
        <path d="M8.3 2.5h7.4l5.8 5.8v7.4l-5.8 5.8H8.3l-5.8-5.8V8.3z" />
        <path d="M9.4 6h5.2l3.4 3.4v5.2L14.6 18H9.4L6 14.6V9.4z" stroke-dasharray="1.6 1.6" />
      </>
    )
  }
  {
    type === 'kids-ados' && (
      <>
        {/* Un grand et un petit */}
        <circle cx="8.5" cy="6" r="3" />
        <path d="M3 21v-3.2A4.3 4.3 0 0 1 7.3 13.5h2.4A4.3 4.3 0 0 1 14 17.8V21" />
        <circle cx="17.5" cy="10.5" r="2.2" />
        <path d="M14.8 21v-1.8a3.1 3.1 0 0 1 3.1-3.1h.4A3.2 3.2 0 0 1 21.5 19.3V21" />
      </>
    )
  }
  {
    type === 'feminin' && (
      <>
        {/* Symbole féminin */}
        <circle cx="12" cy="8.5" r="5.5" />
        <path d="M12 14v8M8.5 18.5h7" />
      </>
    )
  }
</svg>
